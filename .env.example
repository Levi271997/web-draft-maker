# Copy to .env and fill in one provider's key.
#
# The generator talks to an OpenAI-compatible API. DeepSeek serves one, so it
# works through the same SDK with a different base URL.
#
# Leave LLM_PROVIDER unset and whichever key you supply is used. Set it
# explicitly when both keys are present.
# LLM_PROVIDER=openai   # or: deepseek

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# --- DeepSeek -------------------------------------------------------------
# Cheaper per token. Two caveats worth knowing before you switch:
#  1. Strict json_schema structured output is an OpenAI feature. On DeepSeek the
#     identity pass falls back to JSON mode and sends the schema as text, which
#     the normalisation afterwards is built to tolerate. If DeepSeek gains
#     json_schema support, set LLM_STRICT_JSON=true to use it.
#  2. The page pass writes a whole document, so it needs room. deepseek-chat
#     was measured accepting max_tokens past 16k and returning a complete page;
#     8k truncated every one. Raise LLM_MAX_OUTPUT_TOKENS if pages come back cut off.
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model name for whichever provider is active.
# OpenAI: gpt-4o  |  DeepSeek: deepseek-chat, deepseek-reasoner
LLM_MODEL=gpt-4o

# Ceiling for the page pass. Defaults to 16000 on both providers.
# LLM_MAX_OUTPUT_TOKENS=16000

# Force strict json_schema on or off. Defaults on for OpenAI, off for DeepSeek.
# LLM_STRICT_JSON=true

# Where the "Book a call" button under the preview points.
NEXT_PUBLIC_BOOKING_URL=https://digitalfeet.com/contact
